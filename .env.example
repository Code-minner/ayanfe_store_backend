PORT=4000
NODE_ENV=production

DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxxx.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxxxx.REGION.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated storefront + admin origins (local and production)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://your-store.com,https://admin.your-store.com

PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
BANK_NAME=First Bank
BANK_ACCOUNT_NAME=AYANFE STORE
BANK_ACCOUNT_NUMBER=9182747839
CHECKOUT_FEE=3500

ZEPTOMAIL_HOST=api.zeptomail.com
ZEPTOMAIL_TOKEN="Zoho-enczapikey YOUR_TOKEN"
ZEPTOMAIL_FROM_EMAIL=noreply@your-verified-domain.com
ZEPTOMAIL_FROM_NAME=Ayanfe Store
ADMIN_EMAIL=you@your-domain.com
ADMIN_APP_URL=https://admin.your-store.com
STOREFRONT_URL=https://your-store.com
# Optional override. Emails need an https:// logo (Gmail blocks base64 data URIs).
# Defaults to STOREFRONT_URL/brand/attog-logo.png or ADMIN_APP_URL/brand/attog-logo.png
EMAIL_LOGO_URL=https://your-store.com/brand/attog-logo.png

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
